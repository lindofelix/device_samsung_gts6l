# Recovery init for Samsung gts6l (Qualcomm SM8150)
# Adapted from the stock recovery's init.recovery.qcom.rc

# Health HAL real de Samsung (ver HALLAZGO batería legacy). Pegado directo
# aca en vez de un archivo aparte + import, porque no confirmamos que el
# init de OrangeFox soporte "import" - este archivo si sabemos que se carga
# (matchea ro.hardware=qcom).
# El binario y sus 7 librerias (ver recovery/root/system/lib64 y
# recovery/root/system/bin/hw) estan embebidos en el ramdisk, copiados a
# mano desde /vendor y /system del equipo real - asi no depende de que
# /vendor este montado en recovery (nunca se monta solo, ver mas abajo).
service health-hal-2-1-samsung /system/bin/hw/android.hardware.health@2.1-service-samsung
    class hal charger
    user system
    group system
    capabilities WAKE_ALARM
    file /dev/kmsg w
    # Sin esto, init nunca sabe que ESTE proceso es el que atiende la
    # interfaz: OrangeFox pide ctl.interface_start para 2.0 (visto en dmesg),
    # asi que declaramos las dos versiones que puede pedir.
    interface android.hardware.health@2.0::IHealth default
    interface android.hardware.health@2.1::IHealth default
    # El binario pide libutils.so como NEEDED directo, asi que el soname ya
    # queda resuelto contra /system/lib64/libutils.so (la de OrangeFox, sin
    # el simbolo que la impl de Samsung necesita) ANTES de que se llegue al
    # dlopen de la impl - por eso LD_LIBRARY_PATH nunca tuvo efecto (solo
    # cambia el orden de busqueda, no fuerza una carga). LD_PRELOAD si fuerza
    # la carga de esta lib especifica antes de procesar los NEEDED del
    # binario. Afecta SOLO este proceso, no al resto de OrangeFox.
    setenv LD_PRELOAD /vendor/lib64/libutils.so

on init
    setprop sys.usb.configfs 1

# androidboot.usbcontroller=a600000.dwc3 is passed on the kernel cmdline
on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

# fstab uses /dev/block/bootdevice/by-name/*
on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# El binario del health-hal se copia al ramdisk por el rsync de
# recovery/root/, que NO graba la etiqueta SELinux de sepolicy/file_contexts
# (esa solo se aplica en el empaquetado normal de OrangeFox). La regla ya
# esta compilada en la politica - restorecon la aplica ahora, a mano, en
# tiempo de arranque, leyendo esa misma politica ya cargada.
on fs
    restorecon_recursive /system/bin/hw
    restorecon_recursive /system/lib64
    restorecon_recursive /vendor/lib64
    restorecon /vendor/manifest.xml

# Mount pstore (kernel panic log, if the kernel's DTB reserves RAM for it -
# not confirmed on this device). After a panic + reboot into recovery:
#   adb shell ls /sys/fs/pstore
#   adb pull /sys/fs/pstore/console-ramoops-0
on fs
    mkdir /sys/fs/pstore 0755 root root
    mount pstore pstore /sys/fs/pstore

# "/system/bin/mount /vendor" (lo que habia antes) nunca funciono porque el
# comando "mount" generico (toybox) necesita resolver el punto de montaje
# contra un /etc/fstab tradicional, que este recovery no tiene (OrangeFox usa
# su propio recovery.fstab, un formato distinto que solo entiende el binario
# de recovery). El "mount" INTEGRADO de init no depende de ningun fstab: se
# le da tipo + device + punto de montaje directo, y monta sin mas.
# El health-hal ya no necesita /vendor montado (binario + libs van
# embebidos en el ramdisk), pero lo dejamos por si algo mas lo necesita.
on boot
    wait /dev/block/bootdevice/by-name/system
    mkdir /system_root 0755 root root
    mount ext4 /dev/block/bootdevice/by-name/system /system_root
    wait /dev/block/bootdevice/by-name/vendor
    mkdir /vendor 0755 root root
    mount ext4 /dev/block/bootdevice/by-name/vendor /vendor
    start health-hal-2-1-samsung
