<?xml version="1.0"?>
<!-- OrangeFox theme by fordownloads and OrangeFox team -->
<recovery>
	<details>
		<resolution width="2560" height="1600" />
		<themeversion>3</themeversion>
	</details>
	
	<include>

		<xml name="%fox_navbar_path%/navbar.xml" default="/twres/themes/navbar.xml"/>
		<xml name="%fox_theme_path%/font.xml"    default="/twres/themes/font.xml"/>
		<xml name="%fox_theme_path%/style.xml"   default="/twres/themes/style.xml"/>
		<xml name="%fox_theme_path%/accent.xml"  default="/twres/themes/accent.xml"/>

		<xml name="/twres/resources/vars.xml"/>
		<xml name="/twres/resources/images.xml"/>
		<xml name="/twres/resources/styles.xml"/>
	
		<xml name="/twres/pages/templates/base.xml"/>
		<xml name="/twres/pages/templates/keyboard.xml"/>
		<xml name="/twres/pages/templates/navbar.xml"/>
		<xml name="/twres/pages/templates/statusbar.xml"/>
		<xml name="/twres/pages/templates/templates.xml"/>
		
		<!-- TEST BUILD #3: chrome_test.xml (placeholder main page) + install.xml
		     (flash_confirm) + files.xml (file manager, 26 sub-pages). Everything
		     else still deliberately left out until it's ported. -->
		<xml name="/twres/pages/chrome_test.xml"/>
		<xml name="/twres/pages/install.xml"/>
		<xml name="/twres/pages/files.xml"/>

		<xmlfile name="pages/recovery.xml"/>
	</include>
	<variables>
		<variable name="magisk_ver" value="30.7"/>
		<variable name="fox_theme_version" value="1.2"/>
	</variables>
</recovery>
